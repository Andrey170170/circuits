{
  "schema_version": "adag.process-witness.annotation-ontology.v2",
  "ontology_id": "process-witness-graph-blind-v2",
  "status": "draft_for_human_review",
  "claim_boundary": "Observable-form rules describe literal text. Semantic rules produce suggestions only and must not be treated as accepted process labels.",
  "multi_label": true,
  "unknown_and_ambiguous_allowed": true,
  "review_vocabularies": {
    "suggestion_status": [
      "suggested_unreviewed",
      "human_accepted",
      "human_corrected",
      "human_rejected",
      "human_ambiguous",
      "human_added"
    ],
    "review_decision": [
      "accepted",
      "corrected",
      "rejected",
      "ambiguous",
      "unreviewed"
    ],
    "event_status": [
      "correct",
      "incorrect",
      "attempted",
      "uncertain",
      "not_applicable",
      "unknown"
    ]
  },
  "axes": {
    "surface_form": {
      "kind": "observable",
      "values": [
        "integer_literal",
        "decimal_literal",
        "horizontal_whitespace",
        "newline_whitespace",
        "sentence_terminal",
        "comma",
        "colon",
        "semicolon",
        "quote",
        "apostrophe",
        "parenthesis",
        "bracket",
        "brace",
        "markdown_marker",
        "thinking_boundary",
        "arrow",
        "other_symbol",
        "compound_surface"
      ]
    },
    "representation": {
      "kind": "observable_or_local_syntax",
      "values": [
        "operator_symbol",
        "equality_symbol",
        "answer_key",
        "answer_value",
        "numeric_relation_result_candidate"
      ]
    },
    "domain": {
      "kind": "semantic_hypothesis",
      "values": [
        "arithmetic",
        "graph_or_state",
        "symbolic_text",
        "comparison_or_game",
        "metacognitive"
      ]
    },
    "operation": {
      "kind": "semantic_hypothesis",
      "values": [
        "addition",
        "subtraction",
        "multiplication",
        "division",
        "modulo",
        "exponentiation",
        "equality_check",
        "order_comparison",
        "state_transition",
        "lookup",
        "encoding_or_decoding",
        "counting",
        "verification",
        "correction"
      ]
    },
    "process_role": {
      "kind": "semantic_hypothesis",
      "values": [
        "operator_cue",
        "input_operand",
        "operand_candidate",
        "intermediate_result",
        "intermediate_result_candidate",
        "state_value",
        "state_value_candidate",
        "state_update",
        "final_result",
        "answer_commitment",
        "verification",
        "verification_cue",
        "correction",
        "correction_cue",
        "planning_cue",
        "uncertainty_cue",
        "unknown"
      ]
    },
    "discourse_role": {
      "kind": "semantic_hypothesis",
      "values": [
        "conclusion_cue",
        "verification_cue",
        "correction_cue",
        "planning_cue",
        "uncertainty_cue"
      ]
    },
    "usage": {
      "kind": "human_selection",
      "values": [
        "process_candidate",
        "nuisance_reference",
        "context_only",
        "exclude",
        "unknown"
      ]
    },
    "token_position": {
      "kind": "observable_or_reviewed_context",
      "values": [
        "span_onset",
        "span_interior",
        "span_terminal",
        "line_initial",
        "line_terminal",
        "thinking_segment",
        "final_answer_segment",
        "unknown"
      ]
    },
    "event_status": {
      "kind": "human_semantic_judgment",
      "values": [
        "correct",
        "incorrect",
        "attempted",
        "uncertain",
        "not_applicable",
        "unknown"
      ]
    }
  },
  "regex_rules": [
    {
      "rule_id": "surface.integer.v1",
      "pattern": "(?<![\\w.])-?\\d+(?![\\w.]|\\.\\d)",
      "axis": "surface_form",
      "value": "integer_literal",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.decimal.v1",
      "pattern": "(?<![\\w.])-?\\d+\\.\\d+(?![\\w.])",
      "axis": "surface_form",
      "value": "decimal_literal",
      "interpretation": "observable_form",
      "confidence": "high",
      "ambiguity": [
        "a compact numbered-list item such as 10.58 may have omitted whitespace after the period"
      ]
    },
    {
      "rule_id": "surface.horizontal-whitespace.v1",
      "pattern": "[ \\t]+",
      "axis": "surface_form",
      "value": "horizontal_whitespace",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.newline.v1",
      "pattern": "(?:\\r\\n|\\r|\\n)+",
      "axis": "surface_form",
      "value": "newline_whitespace",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.sentence-terminal.v1",
      "pattern": "(?:(?<!\\d)\\.(?!\\d)|[!?])",
      "axis": "surface_form",
      "value": "sentence_terminal",
      "interpretation": "observable_form",
      "confidence": "high",
      "ambiguity": [
        "a period may be abbreviation punctuation"
      ]
    },
    {
      "rule_id": "surface.comma.v1",
      "pattern": ",",
      "axis": "surface_form",
      "value": "comma",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.colon.v1",
      "pattern": ":",
      "axis": "surface_form",
      "value": "colon",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.semicolon.v1",
      "pattern": ";",
      "axis": "surface_form",
      "value": "semicolon",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.quote.v1",
      "pattern": "\\\"",
      "axis": "surface_form",
      "value": "quote",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.apostrophe.v1",
      "pattern": "'",
      "axis": "surface_form",
      "value": "apostrophe",
      "interpretation": "observable_form",
      "confidence": "high",
      "ambiguity": [
        "may delimit a single-quoted string rather than mark a contraction or possessive"
      ]
    },
    {
      "rule_id": "surface.parenthesis.v1",
      "pattern": "[()]",
      "axis": "surface_form",
      "value": "parenthesis",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.bracket.v1",
      "pattern": "[\\[\\]]",
      "axis": "surface_form",
      "value": "bracket",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.brace.v1",
      "pattern": "[{}]",
      "axis": "surface_form",
      "value": "brace",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.markdown.v1",
      "pattern": "(?:\\*\\*|__|#{1,6}(?=\\s)|```|`)",
      "axis": "surface_form",
      "value": "markdown_marker",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "surface.thinking-boundary.v1",
      "pattern": "</?think>",
      "axis": "surface_form",
      "value": "thinking_boundary",
      "interpretation": "observable_form",
      "confidence": "high",
      "ignore_case": true
    },
    {
      "rule_id": "surface.arrow.v1",
      "pattern": "(?:->|→|⇒|↔)",
      "axis": "surface_form",
      "value": "arrow",
      "interpretation": "observable_form",
      "confidence": "high"
    },
    {
      "rule_id": "representation.equality.v1",
      "pattern": "(?:(?<![<>=!])=(?!=)|≡|≈)",
      "axis": "representation",
      "value": "equality_symbol",
      "interpretation": "observable_form",
      "confidence": "high",
      "ambiguity": [
        "may express assignment, congruence, or approximation rather than equality checking"
      ]
    },
    {
      "rule_id": "operation.modulo-compact.v1",
      "pattern": "(?i)(?<![A-Za-z])mod(?=\\s*[-+]?\\d)",
      "axis": "operation",
      "value": "modulo",
      "interpretation": "semantic_hypothesis",
      "confidence": "high",
      "ambiguity": [
        "may describe a premise or verification rather than an executed operation"
      ]
    },
    {
      "rule_id": "operation.superscript-square.v1",
      "pattern": "²",
      "axis": "operation",
      "value": "exponentiation",
      "interpretation": "semantic_hypothesis",
      "confidence": "high"
    }
  ],
