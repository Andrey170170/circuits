  "detectors": [
    {
      "rule_id": "operation.arithmetic-symbol.v1",
      "detector": "arithmetic_symbols",
      "symbols": {
        "+": "addition",
        "-": "subtraction",
        "*": "multiplication",
        "×": "multiplication",
        "/": "division",
        "÷": "division",
        "%": "modulo",
        "^": "exponentiation"
      },
      "axis": "operation",
      "interpretation": "semantic_hypothesis",
      "confidence": "medium",
      "ambiguity": [
        "local syntax looks arithmetic but may quote a premise or rejected computation"
      ]
    },
    {
      "rule_id": "representation.operator-symbol.v1",
      "detector": "arithmetic_symbols",
      "symbols": {
        "+": "operator_symbol",
        "-": "operator_symbol",
        "*": "operator_symbol",
        "×": "operator_symbol",
        "/": "operator_symbol",
        "÷": "operator_symbol",
        "%": "operator_symbol",
        "^": "operator_symbol"
      },
      "axis": "representation",
      "interpretation": "observable_or_local_syntax",
      "confidence": "high"
    },
    {
      "rule_id": "representation.json-answer.v1",
      "detector": "json_answers",
      "axis": "representation",
      "interpretation": "observable_or_local_syntax",
      "confidence": "high"
    },
    {
      "rule_id": "process.numeric-relation-result.v1",
      "detector": "numeric_relation_results",
      "axis": "process_role",
      "value": "intermediate_result_candidate",
      "interpretation": "semantic_hypothesis",
      "confidence": "medium",
      "ambiguity": [
        "the relation may be a premise, assignment, transition, or incorrect computation"
      ]
    }
  ],
  "token_assignment_contract": {
    "within_axis": "zero_or_one_effective_value_per_authoritative_response_token",
    "across_axes": "independent_values_may_overlap_on_the_same_token",
    "surface_compound_policy": "two_or_more_distinct_machine_surface_form_values_on_one_token_project_to_compound_surface",
    "semantic_conflict_policy": "two_or_more_distinct_machine_values_on_any_other_axis_remain_explicit_unresolved_conflicts"
  }
}

