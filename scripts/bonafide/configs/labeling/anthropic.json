{
  "schema_version": "adag.labeling.recipe.v1",
  "recipe_id": "anthropic-original-upgraded-v1",
  "description": "Claude Haiku 4.5 candidate generation, fixed Transluce scoring, and Claude Opus 5 summarization.",
  "candidate_samples": 5,
  "candidate_generator": {
    "provider": "anthropic",
    "model": "claude-haiku-4-5-20251001",
    "transport": "native_batch",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_output_tokens": 500,
    "temperature": 0.8,
    "concurrency": 32,
    "timeout_seconds": 120,
    "retry": {"max_attempts": 4, "initial_backoff_seconds": 1, "max_backoff_seconds": 30}
  },
  "scorer": {
    "backend": "transluce_finetuned",
    "model": "Transluce/llama_8b_simulator",
    "gpu_index": 0,
    "source_tokenizer": "Qwen/Qwen3-4B-Instruct-2507",
    "source_tokenizer_revision": "cdbee75f17c01a7cc42f958dc650907174af0554",
    "aggregate": "polarity_aligned_mean",
    "alignment": "character_overlap"
  },
  "cluster_summarizer": {
    "provider": "anthropic",
    "model": "claude-opus-5",
    "transport": "native_batch",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_output_tokens": 300,
    "temperature": 0,
    "reasoning": {"type": "adaptive"},
    "concurrency": 16,
    "timeout_seconds": 180,
    "retry": {"max_attempts": 4, "initial_backoff_seconds": 1, "max_backoff_seconds": 30}
  },
  "price_snapshot": "prices-2026-07-27.json"
}
